{
  "name": "@chmose023/minicad-web",
  "version": "0.1.0",
  "description": "Lightweight 2D CAD engine for the web — WebAssembly + WebGL2, framework-agnostic Web Component",
  "keywords": ["cad", "webassembly", "webgl", "web-component", "2d"],
  "author": "CHMOSE023",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CHMOSE023/MiniCAD.git"
  },
  "type": "module",
  "main": "./dist-lib/minicad.cjs.js",
  "module": "./dist-lib/minicad.es.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist-lib/minicad.es.js",
      "require": "./dist-lib/minicad.cjs.js",
      "types": "./dist-lib/index.d.ts"
    },
    "./wasm/minicad.js": "./dist-lib/wasm/minicad.js",
    "./wasm/minicad.wasm": "./dist-lib/wasm/minicad.wasm",
    "./wasm/minicad.data": "./dist-lib/wasm/minicad.data"
  },
  "files": [
    "dist-lib"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "vite build --mode lib && tsc --emitDeclarationOnly --declaration --declarationDir dist-lib --noEmit false",
    "prepublishOnly": "npm run build:lib",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@rollup/pluginutils": "^5.3.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-glsl": "^1.3.0"
  }
}
